<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kiven.lpp.ourpact.activity.mapper.ActivityPhotoMapper">

    <select id="lockCount" resultType="int">
        SELECT COUNT(*)
        FROM act_photo
        WHERE activity_id = #{activityId}
          AND deleted = 0
        FOR UPDATE
    </select>

</mapper>
